+// ─── DurationSpinner — hold-time picker with a live stopwatch ─────────────────
+// Two ways in: nudge the number to a planned hold, or run the stopwatch during
+// the set and let it fill the value on stop — the usual flow for a dead hang or
+// a plank where you don't know the number until you drop.
+function DurationSpinner({ value, onChange, color, placeholder=DEFAULT_HOLD_SECS }) {
+  const [showPad, setShowPad] = useState(false);
+  const [running, setRunning] = useState(false);
+  const [elapsed, setElapsed] = useState(0);      // ms on the running clock
+  const startedAtRef = useRef(null);
+  const rafRef = useRef(null);
+  const holdRef = useRef(null);
+
+  const secs = parseDurationVal(value);
+
+  function adj(d){ onChange(String(Math.max(0, secs + d))); }
+  // adj closes over `secs`, so the repeat interval calls through a fresh copy
+  const adjRef = useRef(adj);
+  useEffect(()=>{ adjRef.current = adj; });
+  function beginHold(d){ holdRef.current = setInterval(()=>adjRef.current(d), 130); }
+  function endHold(){ clearInterval(holdRef.current); }
+
+  // Stopwatch tick — wall-clock based so backgrounding the tab can't drift it
+  useEffect(()=>{
+    if(!running) return;
+    const tick=()=>{
+      setElapsed(Date.now() - startedAtRef.current);
+      rafRef.current = setTimeout(tick, 100);
+    };
+    tick();
+    return ()=>clearTimeout(rafRef.current);
+  },[running]);
+
+  useEffect(()=>()=>{ clearInterval(holdRef.current); clearTimeout(rafRef.current); },[]);
+
+  function startWatch(){
+    startedAtRef.current = Date.now();
+    setElapsed(0);
+    setRunning(true);
+  }
+  function stopWatch(){
+    const held = Math.max(1, Math.round((Date.now() - startedAtRef.current)/1000));
+    setRunning(false);
+    setElapsed(0);
+    onChange(String(held));
+  }
+
+  const liveSecs = Math.floor(elapsed/1000);
+  const display = running ? fmtDuration(liveSecs) : (secs === 0 ? fmtDuration(placeholder) : fmtDuration(secs));
+
+  return (
+    <div>
+      <div style={{display:"flex",alignItems:"center",gap:8}}>
+        <button onPointerDown={()=>{if(running)return;adj(-5);beginHold(-5);}} onPointerUp={endHold} onPointerLeave={endHold}
+          disabled={running}
+          style={{width:60,height:60,borderRadius:14,background:"#1a1a1a",
+            border:`2px solid ${running?"#252525":color+"44"}`,color:running?"#2a2a2a":color,fontSize:30,
+            cursor:running?"default":"pointer",
+            flexShrink:0,display:"flex",alignItems:"center",justifyContent:"center",userSelect:"none"}}>−</button>
+
+        <div onClick={()=>{if(!running)setShowPad(true);}} tabIndex={0}
+          onKeyDown={e=>{
+            if(running) return;
+            if(e.key==="Enter"||e.key==="Escape"){e.target.blur();return;}
+            if(e.key==="Backspace"){onChange(String(value||"").slice(0,-1));e.preventDefault();return;}
+            if(/^[0-9]$/.test(e.key)){onChange(String(value||"")+e.key);e.preventDefault();}
+          }}
+          style={{
+          flex:1,height:60,borderRadius:14,background:running?`${color}14`:"#111",
+          border:`2px solid ${running?color:color+"55"}`,cursor:running?"default":"pointer",
+          display:"flex",alignItems:"center",justifyContent:"center",gap:6,position:"relative",
+          outline:"none"}}>
+          <span style={{fontFamily:"'Bebas Neue',sans-serif",fontSize:36,
+            color:running?color:(secs===0?"#383838":color),letterSpacing:1,pointerEvents:"none"}}>
+            {display}
+          </span>
+          <span style={{color:running?color+"88":"#333",fontSize:13,pointerEvents:"none",position:"absolute",right:12}}>
+            {running?"● REC":"hold"}
+          </span>
+        </div>
+
+        <button onPointerDown={()=>{if(running)return;adj(5);beginHold(5);}} onPointerUp={endHold} onPointerLeave={endHold}
+          disabled={running}
+          style={{width:60,height:60,borderRadius:14,background:"#1a1a1a",
+            border:`2px solid ${running?"#252525":color+"44"}`,color:running?"#2a2a2a":color,fontSize:30,
+            cursor:running?"default":"pointer",
+            flexShrink:0,display:"flex",alignItems:"center",justifyContent:"center",userSelect:"none"}}>+</button>
+      </div>
+
+      {/* Stopwatch — time the hold live, drop, tap stop */}
+      <button onClick={()=>running?stopWatch():startWatch()}
+        style={{width:"100%",height:46,marginTop:8,borderRadius:12,cursor:"pointer",
+          background:running?color:"#141414",
+          border:`2px solid ${running?color:color+"33"}`,
+          color:running?"#000":color,
+          fontFamily:"'Barlow Condensed',sans-serif",fontWeight:700,fontSize:14,letterSpacing:3,
+          display:"flex",alignItems:"center",justifyContent:"center",gap:8,transition:"all 0.12s"}}>
+        {running ? <>⏹ STOP — {fmtDuration(liveSecs)}</> : <>⏱ START TIMER</>}
+      </button>
+
+      {showPad&&<NumPad value={secs||""} label="Hold (seconds)" unit="sec"
+        color={color} onConfirm={v=>{onChange(v);setShowPad(false);}} onClose={()=>setShowPad(false)}/>}
+    </div>
+  );
+}
