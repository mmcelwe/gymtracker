+// ══════════════════════════════════════════════════════════════════════════════
+// TIMED EXERCISES — planks, dead hangs, wall sits, loaded carries
+// ══════════════════════════════════════════════════════════════════════════════
+// An exercise carries mode:"reps" (default) or mode:"duration". A duration
+// exercise stores its target hold in `ex.duration` (seconds); each logged set
+// carries `duration` (seconds) instead of `reps`. Everything else — weight,
+// RPE, sets, rest, supersets — behaves identically, so a weighted plank or a
+// weighted dead hang logs its added load the same way a squat does.
+
+// Names that are inherently timed. Matched loosely so "Weighted Plank",
+// "Side Plank (L)" and "RKC Plank" all resolve without a lookup table.
+// Deliberately narrow: "hang" alone would swallow Hang Clean / Hang Snatch.
+const TIMED_NAME_PATTERNS = [
+  /\bplanks?\b/i,
+  /\bdead[- ]?hang/i, /\bbar hang/i, /\bpassive hang/i, /\bactive hang/i,
+  /\bwall sit/i,
+  /\bhollow (hold|body)/i,
+  /\bl[- ]?sit/i,
+  /\bhold\b/i,          // Superman Hold, Iso Hold, Chin-up Hold, Bridge Hold
+  /\biso(metric)?\b/i,
+  /\b(farmer'?s? (walk|carry)|suitcase carry|loaded carry|overhead carry)\b/i,
+];
+
+function isTimedByName(name) {
+  if(!name) return false;
+  return TIMED_NAME_PATTERNS.some(re => re.test(name));
+}
+
+// Seconds from a loose value: 45, "45", "45s", "1:30", "0:45"
+function parseDurationVal(v) {
+  if(v == null || v === "") return 0;
+  if(typeof v === "number") return isFinite(v) ? Math.max(0, Math.round(v)) : 0;
+  const str = String(v).trim();
+  const mmss = str.match(/^(\d+):([0-5]?\d)$/);
+  if(mmss) return parseInt(mmss[1])*60 + parseInt(mmss[2]);
+  const n = parseFloat(str);
+  return isNaN(n) ? 0 : Math.max(0, Math.round(n));
+}
+
+// 45 → "45s"; 90 → "1:30"; 125 → "2:05"
+function fmtDuration(secs) {
+  const s = parseDurationVal(secs);
+  if(s < 60) return `${s}s`;
+  return `${Math.floor(s/60)}:${String(s%60).padStart(2,"0")}`;
+}
+
+const DEFAULT_HOLD_SECS = 45;
+
+// Resolve an exercise's tracking mode. An explicit `mode` always wins; older
+// programs are inferred so "Plank / 45s" from the starter templates and any
+// hand-typed "Dead Hang" behave as timed work without needing a migration.
+function exMode(ex) {
+  if(ex?.mode === "duration" || ex?.mode === "reps") return ex.mode;
+  if(typeof ex?.reps === "string" && /^\d+\s*s$/i.test(ex.reps.trim())) return "duration";
+  return isTimedByName(ex?.name) ? "duration" : "reps";
+}
+function isDurationEx(ex) { return exMode(ex) === "duration"; }
+
+// Target hold in seconds for a duration exercise
+function exTargetSecs(ex) {
+  const d = parseDurationVal(ex?.duration);
+  if(d > 0) return d;
+  // Starter templates encode a hold as reps:"45s". Only that explicit form
+  // counts — a bare "12" is a rep count, and reading it as 12 seconds would
+  // silently mangle the target when an exercise is switched to timed.
+  if(typeof ex?.reps === "string" && /^\d+\s*s$/i.test(ex.reps.trim())) {
+    const legacy = parseDurationVal(ex.reps);
+    if(legacy > 0) return legacy;
+  }
+  return DEFAULT_HOLD_SECS;
+}
+
+// A logged set is a timed set when it carries a duration
+function isDurationSet(s) { return !!s && parseDurationVal(s.duration) > 0; }
+function setSecs(s) { return parseDurationVal(s?.duration); }
+
+// Time-under-tension → rep-equivalent, so timed holds contribute to volume and
+// muscle-stimulus totals on the same scale as straight sets instead of counting
+// as zero. ~3s of hold ≈ one rep of work.
+const TUT_SECS_PER_REP = 3;
+function setRepUnits(s) {
+  if(isDurationSet(s)) return setSecs(s) / TUT_SECS_PER_REP;
+  return parseFloat(s?.reps) || 0;
+}
+// Does this set carry anything loggable? (replaces bare `s.reps` truthiness)
+function setHasWork(s) { return !!s && (!!s.reps || isDurationSet(s)); }
+
+// Short "12" / "45s" label for a logged set
+function setAmountLabel(s) {
+  return isDurationSet(s) ? fmtDuration(setSecs(s)) : String(s?.reps ?? "");
+}
+
+// Defaults for a freshly added exercise. Timed names arrive already set to
+// duration mode; `reps` is kept so flipping the editor toggle back has a value.
+function newExFields(name) {
+  return isTimedByName(name)
+    ? {reps:"10", mode:"duration", duration:DEFAULT_HOLD_SECS}
+    : {reps:"10", mode:"reps"};
+}
